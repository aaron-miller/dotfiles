# aws
awsp() {
  if ! command -v aws &>/dev/null; then
    echo "awsp: aws CLI is not installed" >&2
    return 1
  fi
  local profile=$(aws configure list-profiles | fzf --height 40% --prompt="AWS Profile> ")
  [[ -n "$profile" ]] && export AWS_PROFILE="$profile" && echo "→ $profile"
}

# llm wrapper - usage: ask-llm <prompt>
ask-llm() {
  if [[ $# -eq 0 ]]; then
    echo "ask-llm: no prompt provided" >&2
    return 1
  fi
  llm "$*"
}

# workspaces and spaces - scripts in ~/.scripts: worktree, workflow
# layout: ~/src/<repo> (clones), ~/wrk/<workspace>/<repo>/<branch> (spaces)

# fzf over space paths - usage: _wt_pick <prompt> [<workspace>]
_wt_pick() {
  command -v fzf &>/dev/null || { echo "fzf is not installed" >&2; return 1; }
  local list
  list=$(worktree ls "${@:2}") || return 1
  if [[ -z $list ]]; then
    echo "no spaces found" >&2
    return 1
  fi
  print -r -- "$list" | fzf --height 40% --prompt="$1"
}

# prints the workspace name if $PWD is under ~/wrk
_ws_current() {
  [[ $PWD == "$HOME"/wrk/* ]] || return 1
  local rel=${PWD#"$HOME"/wrk/}
  print -r -- "${rel%%/*}"
}

# create (if needed) and attach to a workspace - usage: ws [<ticket>]
ws() {
  local ticket=$1
  if [[ -z $ticket ]]; then
    command -v fzf &>/dev/null || { echo "fzf is not installed" >&2; return 1; }
    ticket=$(workflow workspace ls | fzf --height 40% --prompt="workspace> " | cut -f1) || return
  fi
  [[ -n $ticket ]] || return 1
  workflow workspace new "$ticket" || return
  cd "$HOME/wrk/$ticket" || return
  workflow workspace attach "$ticket"
}

# cd to a space in the current workspace - usage: wt
wt() {
  local ws dest
  ws=$(_ws_current) || { echo "wt: not in a workspace; use wtl" >&2; return 1; }
  dest=$(_wt_pick "space> " "$ws") || return
  [[ -n $dest ]] && cd "$dest"
}

# cd to any space under ~/wrk - usage: wtl
wtl() {
  local dest
  dest=$(_wt_pick "space> ") || return
  [[ -n $dest ]] && cd "$dest"
}

# create a space for the current repo in a workspace and cd to it - usage: mkwt [<desc>]
mkwt() {
  local desc=$1 ws repo dest common
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
    || { echo "mkwt: not inside a git repo" >&2; return 1; }
  repo=${common:h:t}

  ws=$(_ws_current) || ws=$(workflow workspace ls | fzf --height 40% --prompt="workspace> " | cut -f1) || return
  [[ -n $ws ]] || return 1

  if [[ -z $desc ]]; then
    read "desc?desc> " || return
  fi
  [[ -n $desc ]] || { echo "mkwt: no desc given" >&2; return 1; }

  dest=$(worktree new "$ws" "$repo" "$desc") || return
  cd "$dest"
}

# remove a space's worktree (refuses if not ready); branch deleted only if merged - usage: rmwt
rmwt() {
  local dest common main
  dest=$(_wt_pick "remove> ") || return
  [[ -n $dest ]] || return 1
  common=$(git -C "$dest" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return
  main=${common:h}
  worktree rm "$dest" || return
  if [[ $PWD == "$dest" || $PWD == "$dest"/* ]]; then
    cd "$main"
  fi
}
