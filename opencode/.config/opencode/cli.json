{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "kanagawa-transparent"
  },
  "keybinds": {
    "session.tab.previous": "<leader>[,alt+up",
    "session.tab.next": "<leader>],alt+down"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "hide",
    "submit_scroll": "bottom",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "low",
    "image_preview": false,
    "new_location": "launch",
    "permissions": "prompt"
  },
  "animations": true,
  "attention": {
    "sound": true,
    "notifications": true
  },
  "highlights": false
}
