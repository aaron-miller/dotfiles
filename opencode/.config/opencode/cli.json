{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "kanagawa-transparent"
  },
  "keybinds": {
    "session.tab.previous": "<leader>[,alt+up",
    "session.tab.next": "<leader>],alt+down"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true
}
