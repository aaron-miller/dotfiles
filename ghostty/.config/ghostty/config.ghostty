font-family = Hack Nerd Font Mono
font-size = 20
theme = Catppuccin Mocha
background-opacity = 0.85
background-blur = 10
window-width = 120
window-height = 36
scrollbar = system
mouse-scroll-multiplier = discrete:1
confirm-close-surface = false
window-decoration = false
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# send Alt+1-0 to tmux for window switching (unshifted Cmd+1-0 doesn't fire in Ghostty)
keybind = super+shift+one=text:\x1b1
keybind = super+shift+two=text:\x1b2
keybind = super+shift+three=text:\x1b3
keybind = super+shift+four=text:\x1b4
keybind = super+shift+five=text:\x1b5
keybind = super+shift+six=text:\x1b6
keybind = super+shift+seven=text:\x1b7
keybind = super+shift+eight=text:\x1b8
keybind = super+shift+nine=text:\x1b9
keybind = super+shift+zero=text:\x1b0
